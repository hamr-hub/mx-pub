{
  "_comment": "Per-platform publish config. 'selectors' use CSS or @e refs from snapshot(). Keep values conservative — re-derive via `snapshot()` when a platform redesigns their creator console. See publish-workflow.md § 'Updating selectors'.",
  "_version": 1,

  "douyin": {
    "display_name": "抖音",
    "publish_url": "https://creator.douyin.com/creator-micro/upload",
    "login_url": "https://creator.douyin.com/",
    "supports_video": true,
    "supports_image_carousel": true,
    "selectors": {
      "upload_input": "input[type=file][accept*='video'], input[type=file][accept*='image']",
      "title_input": "input[placeholder*='作品标题'], .editor-title input, [contenteditable=true].title",
      "description_input": "textarea[placeholder*='添加作品简介'], .editor-desc textarea, [contenteditable=true].desc",
      "tag_input": "input[placeholder*='话题'], .tag-input input, [contenteditable=true].tag",
      "tag_suggestion_first": ".topic-suggestion-item:first-child, .suggest-list li:first-child",
      "tag_add_button": ".add-topic-btn, button:has-text('添加话题')",
      "location_input": "input[placeholder*='添加位置'], .location-input input",
      "cover_upload": "input[type=file][accept*='image']",
      "publish_button": "button.publish-btn, button:has-text('发布'), .footer-publish button",
      "draft_button": "button:has-text('存草稿')"
    },
    "limits": {
      "title_max_chars": 30,
      "description_max_chars": 2200,
      "tags_max_count": 10,
      "video_max_size_mb": 128,
      "image_max_count_per_post": 35
    },
    "upload_settle_seconds": 8,
    "after_publish_text_gone": "上传中",
    "anti_spam": {
      "min_publish_interval_seconds": 120,
      "max_per_day": 30
    },
    "analytics": {
      "url": "https://creator.douyin.com/creator-micro/data-overview",
      "url_aliases": [
        "https://creator.douyin.com/creator-micro/data-analysis/content",
        "https://creator.douyin.com/creator-micro/home"
      ],
      "fields": [
        {"key": "published_count",    "match": "作品数"},
        {"key": "total_views",        "match": "总播放"},
        {"key": "total_likes",        "match": "总点赞"},
        {"key": "total_comments",     "match": "总评论"},
        {"key": "total_shares",       "match": "总分享"},
        {"key": "total_favorites",    "match": "总收藏"},
        {"key": "fans_count",         "match": "粉丝数"}
      ]
    }
  },

